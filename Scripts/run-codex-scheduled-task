TRUSTED_TZ = "America/New_York"
CONTROL_CHARACTER_RE = re.compile(r"[\x00-\x1f\x7f]")
KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
MANAGER_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_-]*$")
MACHO_MAGICS = {
    b"\xfe\xed\xfa\xce",
    b"\xce\xfa\xed\xfe",
    b"\xfe\xed\xfa\xcf",
    b"\xcf\xfa\xed\xfe",
    b"\xca\xfe\xba\xbe",
    b"\xbe\xba\xfe\xca",
}
ELF_MAGIC = b"\x7fELF"
